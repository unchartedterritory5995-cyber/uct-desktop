{
  "name": "uct-desktop",
  "productName": "UCT Intelligence",
  "version": "0.1.4",
  "private": true,
  "license": "UNLICENSED",
  "description": "Windows desktop shell for UCT Intelligence",
  "author": "UCT Intelligence",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:installer": "npm run build && electron-builder --win nsis --config.directories.output=release-share"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.uctintelligence.desktop",
    "productName": "UCT Intelligence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "UCT-Intelligence-Setup-${version}.${ext}",
      "shortcutName": "UCT Intelligence"
    }
  },
  "dependencies": {
    "koffi": "3.3.7"
  }
}
